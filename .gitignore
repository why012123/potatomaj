# ── 环境 / 构建产物（体积大、可重建，绝不入库）────────────────
.venv/
build/
out/
node_modules/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ── 训练过程的中间产物 ────────────────────────────────────────
# _bcbase 是「纯克隆基线」（做「强化学习到底有没有用」的对照用），
# _prev 是重训前的备份。它们能加载，但不是给人用的。
aimodel/weights/*_bcbase.npz
aimodel/weights/*_prev.npz
aimodel/weights/logs/
aimodel/arena_state.json

# ── 牌图缓存（重新拉一次就有）────────────────────────────────
aimodel/ui/java/.tilecache/

# ── 与麻将平台实时协议相关的部分 ──────────────────────────────
# 本地保留、不入库。这些是「接入某个商业麻将平台、在牌桌上给实时提示」的
# 工具，公开它既违反该平台的服务条款，也会把整个仓库置于 DMCA 风险之下
# （连带下架真正的成果 aimodel/）。
#
# ⚠️ .gitignore 不支持行尾注释 —— 模式必须单独占一行，否则整行会被当成
#    一个模式而永远匹配不上（这里踩过一次，删掉的文件又被 git add 加了回来）。
electron/
.refs/
archive/
tools/protocol.js
tools/decode.js
tools/cache/
potatomaj/bridge.py
run-electron.sh
土豆麻将.command
土豆麻将浏览器.command

# ── 系统杂物 ─────────────────────────────────────────────────
.DS_Store
._*
*.log
*.swp

# ── 网页平台跑起来之后才有的东西（本地保留）───────────────────
# logs/ 下有匿名玩家 ID 的对局流水，run/ 是 PID 文件。
# 这两样都不该进仓库（隐私 + 每次重启都在变）。
logs/
run/
data/profiles.json
games-*.jsonl.gz

# 识图那套已被协议解码替代，这些是它的遗留物（本地保留）
tools/evaluate.py
samples/

# ── 天鳳牌谱数据（仅本机使用：不上传 / 不提交 / 不分发）────────
# GL1.xlsm 是同学提供的 40000 局天鳳四麻牌谱，授权仅限本项目小范围开发
# （验证规则、训练模型）。原始文件、中间 dump、以及由它抽出的训练数据
# 一律不得入库，也不得对外分发。
#
# 注意：下面每一条都必须单独占一行 —— .gitignore 不支持行尾注释，
# 加了注释整行就会被当成一个模式而永远匹配不上（本文件上面已经踩过一次）。
GL1.xlsm
*.xlsm
_data/
data/
data/tenhou*.npz
data/tenhou*/
samples/*.json
samples/*.mjai

# ── mjlog.py 的 dump 落点 ──────────────────────────────────────
# `mjlog.py --out` 默认写到这里，内容是**和 GL1.xlsm 同源的天鳳牌谱** ✗
# 仓库是 public → 一次 `git add -A` 就会推上去 ✓
# 这两条在合并里丢过一次（被 aimodel/tests/test_repo_hygiene.py 当场抓到 ✓）
mjai_dump/
aimodel/mjai_dump/
